        <artifactId>asu-core</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>asu-api-server</artifactId>
    <name>ASU REST API and Web Gateway Application</name>

    <dependencies>
        <dependency>
            <groupId>kg.asugtk</groupId>
            <artifactId>asu-common</artifactId>
        </dependency>
        <dependency>
            <groupId>kg.asugtk</groupId>
